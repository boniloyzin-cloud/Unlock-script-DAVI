-- 1. Fetch raw script content
local rawUrl = "https://raw.githubusercontent.com/boniloyzin-cloud/Yessssssss/refs/heads/main/raw%20(3).txt"
local success, scriptContent = pcall(function()
    return game:HttpGet(rawUrl)
end)

if success and scriptContent then
    -- 2. Direct string replacements for names and developer credits
    local modifiedScript = scriptContent
        :gsub("9rr", "D11")
        :gsub("9RR", "D11")
        :gsub("OCN_PXre%s*-%s*kshopnakub_2271", "DAVI_KDMH")
        :gsub("Ka1zen%s*%(Sir3n%)%s*-%s*Rip_BotiTT", "DAVI_KDMH")
        :gsub("OCN_PXre", "DAVI_KDMH")
        :gsub("kshopnakub_2271", "DAVI_KDMH")
        :gsub("Ka1zen", "DAVI_KDMH")
        :gsub("Sir3n", "DAVI_KDMH")
        :gsub("Rip_BotiTT", "DAVI_KDMH")

    -- 3. Automatic chat message on execution
    task.spawn(function()
        pcall(function()
            local TextChatService = game:GetService("TextChatService")
            local ReplicatedStorage = game:GetService("ReplicatedStorage")

            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                if generalChannel then
                    generalChannel:SendAsync("<<Drr DAVI>> x")
                end
            else
                local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if defaultChat and defaultChat:FindFirstChild("SayMessageRequest") then
                    defaultChat.SayMessageRequest:FireServer("<<Drr DAVI>> x", "All")
                end
            end
        end)
    end)

    -- 4. Execute modified script
    local executeFunc, err = loadstring(modifiedScript)
    if executeFunc then
        executeFunc()
    else
        loadstring(scriptContent)()
    end
else
    warn("Failed to fetch script from URL")
end
